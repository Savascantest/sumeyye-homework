{
  "name": "sumeyye-homework",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "homeworks:index": "node scripts/build-homework-index.mjs",
    "validate:privacy": "node scripts/validate-public-package-privacy.mjs",
    "validate:content": "node scripts/validate-homeworks.mjs",
    "validate": "npm run validate:privacy && npm run validate:content",
    "test:privacy": "node --test tests/public-package-privacy.test.mjs",
    "test": "npm run test:privacy",
    "dev": "npm run homeworks:index && vite",
    "build": "npm run homeworks:index && npm run validate && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.21"
  }
}
