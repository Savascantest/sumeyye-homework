        "title": "always, usually, sometimes, hardly ever, never",
        "intro": "Sıklık zarfları bir şeyin ne kadar sık olduğunu söyler. Ana fiilden önce, be fiilinden sonra gelir.",
        "cards": [
          {
            "title": "Ana fiilden önce",
            "text": "Özne + sıklık zarfı + fiil.",
            "examples": [
              "I always check my bag.",
              "She hardly ever loses her keys."
            ]
          },
          {
            "title": "be fiilinden sonra",
            "text": "am / is / are önce, sıklık zarfı sonra gelir.",
            "examples": [
              "He is usually careful.",
              "They are never late."
            ]
          },
          {
            "title": "Dikkat",
            "tone": "warn",
            "text": "never zaten olumsuzdur; don’t never kullanma."
          }
        ]
      },
      {
        "id": "pronouns",
        "shortTitle": "Zamirler",
        "title": "Subject ve object pronouns",
        "intro": "Özne zamiri işi yapan kişidir; nesne zamiri fiilden sonra işi alan kişiyi veya şeyi değiştirir.",
        "cards": [
          {
            "title": "Subject pronouns",
            "text": "I, you, he, she, it, we, they cümlenin öznesi olur.",
            "examples": [
              "Rachel helps the students. → She helps the students."
            ]
          },
          {
            "title": "Object pronouns",
            "text": "me, you, him, her, it, us, them fiilden veya edattan sonra gelir.",
            "examples": [
              "I can’t find my keys. → I can’t find them.",
              "Rachel helps the students. → She helps them."
            ]
          },
          {
            "title": "Hatırla",
            "text": "Bir ismin yerine zamir koyarken önce o ismin cümlede işi yapan mı, işi alan mı olduğuna bak."
          }
        ]
      }
    ],
