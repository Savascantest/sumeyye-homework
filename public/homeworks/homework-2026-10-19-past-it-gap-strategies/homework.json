  "game": {
    "learn": [
      {
        "id": "rules",
        "shortTitle": "Konu kartları",
        "title": "Geçmiş zaman dedektifi",
        "intro": "Past simple bitmiş olayı, past continuous geçmişte sürmekte olan sahneyi anlatır. Boşluk sorularında zaman sözcükleri ve yardımcı fiiller yol gösterir.",
        "cards": [
          {
            "title": "Past simple",
            "text": "Bitmiş olay: V2; olumsuz ve soruda did + V1.",
            "examples": [
              "Leo left early.",
              "Leo didn't leave early.",
              "Did Leo leave early?"
            ]
          },
          {
            "title": "Past continuous",
            "text": "Sürmekte olan eylem: was/were + V-ing.",
            "examples": [
              "Maya was walking.",
              "They were waiting."
            ]
          },
          {
            "title": "when / while",
            "text": "While çoğunlukla uzun sahneye; when kısa olaya bağlanır.",
            "examples": [
              "While I was sleeping, the phone rang.",
              "I was walking when I saw Mina."
            ]
          },
          {
            "title": "Boşluk taktiği",
            "text": "Önce zaman ipucunu, sonra boşluktan önceki yardımcı fiili, sonra özneyi kontrol et.",
            "examples": [
              "yesterday → past",
              "was ___ → verb-ing",
              "did ___ → base verb"
            ]
          },
          {
            "title": "it tekrar",
            "text": "Saat, hava, mesafe ve genel durumlarda it kullan.",
            "examples": [
              "It was raining.",
              "It was late.",
              "It was five kilometres away."
            ]
          }
        ]
      }
    ],
    "read": {
      "title": "The Missed Train",
      "instructions": "Metni iki kez oku. İlkinde ana fikri, ikincide dil ipuçlarını bul.",
      "tokens": [
        {
          "id": "1",
          "text": "Arda and Maya were walking quickly to the station when it started to rain. ",
          "target": true
        },
        {
          "id": "2",
          "text": "Arda was carrying the tickets, and Maya was checking the time. ",
          "target": true
        },
        {
          "id": "3",
          "text": "While they were crossing the square, a cyclist dropped a bag. ",
          "target": true
        },
        {
          "id": "4",
          "text": "They stopped and helped him. ",
          "target": true
        },
        {
          "id": "5",
          "text": "The cyclist thanked them, but the delay was important. ",
          "target": true
        },
        {
          "id": "6",
          "text": "When they reached the station, the train was leaving. ",
          "target": true
        },
        {
          "id": "7",
          "text": "They missed it, so they waited for the next train. ",
          "target": true
        },
        {
          "id": "8",
          "text": "While they were waiting, they bought hot drinks and called their friend.",
          "target": true
        }
      ],
      "questions": [
        {
          "id": "r1",
          "prompt": "What were they doing when it started to rain?",
          "options": [
            "Walking to the station",
            "Buying drinks",
            "Riding a bicycle"
