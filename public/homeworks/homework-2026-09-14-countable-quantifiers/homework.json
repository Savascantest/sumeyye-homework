        "title": "Sayılabilir mi, sayılamaz mı?",
        "intro": "Sayılabilen tekil isimler a/an alır; sayılamayanlar sayı ile kullanılmaz. Some olumlu, any soru ve olumsuz cümlelerde sık görülür.",
        "cards": [
          {
            "title": "Countable nouns",
            "text": "Tekil ve çoğul olabilir. Tekilken a/an kullan.",
            "examples": [
              "an apple",
              "three tomatoes",
              "a bottle"
            ]
          },
          {
            "title": "Uncountable nouns",
            "text": "Tek tek sayılmaz; ölçü kabıyla sayılabilir.",
            "examples": [
              "some water",
              "a glass of milk",
              "two bags of rice"
            ]
          },
          {
            "title": "some / any",
            "text": "Some: çoğunlukla olumlu. Any: çoğunlukla soru ve olumsuz.",
            "examples": [
              "We have some cheese.",
              "Do we have any eggs?",
              "We don't have any juice."
            ]
          },
          {
            "title": "a few / a little",
            "text": "A few sayılabilen, a little sayılamayan isimlerle kullanılır.",
            "examples": [
              "a few carrots",
              "a little sugar"
            ]
          }
        ]
      }
    ],
